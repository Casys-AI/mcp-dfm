{
  "name": "@casys/mcp-dfm",
  "version": "0.2.2",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@casys/mcp-server"]
  },
  "tasks": {
    "serve": "deno run --allow-all server.ts --port=3018",
    "check": "deno check mod.ts server.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check deno.json mod.ts server.ts src tests scripts",
    "release:check": "deno task fmt && deno task check && deno task lint && deno task test",
    "test": "deno test --allow-all tests/"
  },
  "exports": {
    ".": "./mod.ts",
    "./server": "./server.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "server.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts"
    ]
  },
  "imports": {
    "@casys/mcp-server": "jsr:@casys/mcp-server@0.26.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/streams": "jsr:@std/streams@^1",
    "@std/streams/text-line-stream": "jsr:@std/streams@^1/text-line-stream"
  },
  "fmt": {
    "lineWidth": 88,
    "semiColons": true,
    "singleQuote": false
  }
}
